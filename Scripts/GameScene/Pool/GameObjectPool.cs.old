using System.Collections.Generic;
using UnityEngine;

/// <summary>
/// 通用 GameObject 对象池。
/// </summary>
/// <remarks>
/// 这个类只负责管理同一种 Prefab 实例的创建、取出和归还，不处理具体业务对象的运行时数据。
/// 子弹、特效或飘字接入对象池后，应当在各自的初始化方法中重置目标、计时器、颜色等业务状态。
/// </remarks>
public sealed class GameObjectPool : MonoBehaviour
{
    // ─── 静态池缓存 ─────────────────────────────────────────────

    /// <summary>
    /// 按 Prefab 缓存对象池，保证使用同一个 Prefab 的业务对象共用一个池。
    /// </summary>
    private static readonly Dictionary<GameObject, GameObjectPool> Pools =
        new Dictionary<GameObject, GameObjectPool>();

    // ─── 对象池配置 ─────────────────────────────────────────────

    /// <summary>
    /// 当前对象池对应的 Prefab 模板。
    /// </summary>
    private GameObject _prefab;

    /// <summary>
    /// 对象池内部的根节点，用来统一收纳当前池创建的对象。
    /// </summary>
    private Transform _poolRoot;

    // ─── 池容器 ─────────────────────────────────────────────────

    /// <summary>
    /// 保存当前没有被使用的对象。
    /// Stack 的后进先出特性适合对象池快速取出最近归还的对象。
    /// </summary>
    private readonly Stack<GameObject> _availableObjects =
        new Stack<GameObject>();

    /// <summary>
    /// 记录当前对象池创建并拥有的全部对象。
    /// 这个集合用于校验归还对象是否属于当前对象池，也用于清理池对象。
    /// </summary>
    private readonly HashSet<GameObject> _ownedObjects =
        new HashSet<GameObject>();

    /// <summary>
    /// 记录当前已经被 Get 取出、但还没有 Release 归还的对象。
    /// 这个集合用于检测重复归还，避免同一个对象被压入 Stack 多次。
    /// </summary>
    private readonly HashSet<GameObject> _leasedObjects =
        new HashSet<GameObject>();

    // ─── 生命周期与创建入口 ────────────────────────────────────

    /// <summary>
    /// 根据 Prefab 获取对象池；如果对象池不存在，则运行时创建对象池并进行预热。
    /// </summary>
    /// <param name="prefab">作为对象池模板的 Prefab。</param>
    /// <param name="prewarmCount">对象池首次创建时预先生成的对象数量。</param>
    /// <returns>与指定 Prefab 对应的对象池。</returns>
    public static GameObjectPool GetOrCreate(GameObject prefab, int prewarmCount = 16)
    {
        // Prefab 为空时无法实例化对象，因此直接记录错误并返回空引用。
        if (prefab == null)
        {
            Debug.LogError("[GameObjectPool] 创建对象池失败：Prefab 为空。");
            return null;
        }

        // 如果已经存在对应的对象池，就直接复用，避免同一个预制体创建多个池。
        if (Pools.TryGetValue(prefab, out GameObjectPool existingPool))
        {
            // 如果缓存的对象池仍然有效，就直接返回，不重复预热和创建对象。
            if (existingPool != null)
            {
                // 已经创建过的池不重复预热，避免调用方重复请求时额外生成对象。
                return existingPool;
            }

            // 如果旧池已经被 Unity 销毁，先移除失效缓存，避免后续 Add 抛出重复键异常。
            Pools.Remove(prefab);
        }

        // 创建一个运行时 GameObject 作为对象池的宿主，不需要用户在 Unity 编辑器中手动挂载。
        GameObject poolObject = new GameObject("GameObjectPool_" + prefab.name);

        // 将对象池组件添加到运行时宿主对象上，使它拥有 Unity 生命周期和场景归属。
        GameObjectPool pool = poolObject.AddComponent<GameObjectPool>();

        // 保存 Prefab 和对象池根节点，后续创建的对象都会归属到这个根节点下。
        pool.Initialize(prefab, poolObject.transform);

        // 把新创建的对象池放入静态缓存，供其他防御塔复用。
        Pools.Add(prefab, pool);

        // 预热数量不能小于零，负数配置按零处理，避免 Stack 预热循环出现非法语义。
        int safePrewarmCount = Mathf.Max(0, prewarmCount);

        // 在第一次使用前提前创建一批对象，减少运行过程中的 Instantiate 峰值。
        pool.Prewarm(safePrewarmCount);

        // 返回新创建并完成初始化的对象池。
        return pool;
    }

    /// <summary>
    /// 初始化运行时创建的对象池实例。
    /// </summary>
    /// <param name="prefab">作为对象模板的 Prefab。</param>
    /// <param name="poolRoot">用于收纳池对象的根节点。</param>
    private void Initialize(GameObject prefab, Transform poolRoot)
    {
        // 保存后续动态创建对象时需要使用的 Prefab 引用。
        _prefab = prefab;

        // 保存池根节点，使创建出的对象不会散落在场景根节点下。
        _poolRoot = poolRoot;
    }

    /// <summary>
    /// Unity 销毁对象池宿主时，清理静态缓存和该池拥有的所有对象。
    /// </summary>
    private void OnDestroy()
    {
        // 只有当前字典中的池确实是自己时才移除，避免异常情况下误删其他对象池。
        if (_prefab != null && Pools.TryGetValue(_prefab, out GameObjectPool pool) && pool == this)
        {
            // 从静态缓存中移除当前池，防止场景销毁后继续返回失效的池引用。
            Pools.Remove(_prefab);
        }

        // 销毁池拥有的所有对象，并清空内部容器。
        ClearInternal();
    }

    // ─── 预热与对象创建 ─────────────────────────────────────────

    /// <summary>
    /// 预先创建指定数量的对象，并将它们放入可用对象栈中。
    /// </summary>
    /// <param name="count">需要预先创建的对象数量。</param>
    private void Prewarm(int count)
    {
        // 按调用方传入的数量循环创建对象。
        for (int i = 0; i < count; i++)
        {
            // 创建一个未激活的对象，并登记为当前池所有。
            GameObject instance = CreateInstance();

            // 创建失败时停止预热，避免继续对空引用执行池操作。
            if (instance == null)
            {
                return;
            }

            // 预热对象暂时没有被业务逻辑租借，因此直接放入可用栈。
            _availableObjects.Push(instance);
        }
    }

    /// <summary>
    /// 根据预制体创建一个新的池对象。
    /// </summary>
    /// <returns>新创建的未激活对象；创建失败时返回空引用。</returns>
    private GameObject CreateInstance()
    {
        // 预制体为空时无法继续创建对象，记录错误并安全返回。
        if (_prefab == null)
        {
            Debug.LogError("[GameObjectPool] 创建对象失败：对象池 Prefab 为空。");
            return null;
        }

        // 以对象池根节点为父节点实例化对象，便于在 Hierarchy 中统一管理池对象。
        GameObject instance = Instantiate(_prefab, _poolRoot);

        // 新创建的对象先保持禁用，只有 Get 取出时才允许进入游戏逻辑。
        instance.SetActive(false);

        // 登记对象所有权，Release 时可以据此判断对象是否来自当前池。
        _ownedObjects.Add(instance);

        // 返回已经创建并登记的对象。
        return instance;
    }

    // ─── 取出与归还 ─────────────────────────────────────────────

    /// <summary>
    /// 从对象池取出一个对象，并设置它的世界位置和世界旋转。
    /// </summary>
    /// <param name="position">对象启用时的世界位置。</param>
    /// <param name="rotation">对象启用时的世界旋转。</param>
    /// <returns>已经激活、可以交给业务组件初始化的对象。</returns>
    public GameObject Get(Vector3 position, Quaternion rotation)
    {
        // 先声明取出的对象，后续根据可用栈是否为空决定复用还是扩容。
        GameObject instance = null;

        // 跳过可能已经被 Unity 销毁的无效对象，直到找到有效对象或栈为空。
        while (_availableObjects.Count > 0 && instance == null)
        {
            // 从可用栈顶部取出一个对象，避免重新实例化。
            instance = _availableObjects.Pop();
        }

        // 如果预热对象已经耗尽，则动态创建一个新对象，保证发射逻辑不会因池容量不足而失败。
        if (instance == null)
        {
            // 动态扩容对象同样会登记到当前池的所有权集合中。
            instance = CreateInstance();
        }

        // 创建失败时返回空引用，由调用方决定如何处理异常情况。
        if (instance == null)
        {
            return null;
        }

        // 设置对象的世界位置和世界旋转，保证复用对象从本次业务指定的姿态开始运行。
        instance.transform.SetPositionAndRotation(position, rotation);

        // 记录对象已经被业务逻辑取出，Release 时用它判断是否重复归还。
        _leasedObjects.Add(instance);

        // 激活对象，使对象上的 MonoBehaviour 开始执行对应的运行逻辑。
        instance.SetActive(true);

        // 返回已经准备好的对象。
        return instance;
    }

    /// <summary>
    /// 将一个已经使用完的对象归还到对象池。
    /// </summary>
    /// <param name="instance">需要归还的对象。</param>
    /// <returns>归还成功返回 true；对象非法或重复归还返回 false。</returns>
    public bool Release(GameObject instance)
    {
        // 空引用没有对应的对象可以归还，记录警告并拒绝处理。
        if (instance == null)
        {
            Debug.LogWarning("[GameObjectPool] 归还对象失败：对象为空。");
            return false;
        }

        // 只有由当前对象池创建并登记的对象才允许归还，防止不同池之间混用对象。
        if (!_ownedObjects.Contains(instance))
        {
            Debug.LogWarning("[GameObjectPool] 归还对象失败：对象不属于当前对象池。");
            return false;
        }

        // 只有已经取出的对象才允许归还，防止同一个对象被重复压入可用栈。
        if (!_leasedObjects.Remove(instance))
        {
            Debug.LogWarning("[GameObjectPool] 归还对象失败：对象未被租借或已经归还。");
            return false;
        }

        // 先禁用对象，确保归还后的业务对象不再执行 Update 和其他运行逻辑。
        instance.SetActive(false);

        // 把对象重新放入可用栈，供下一次 Get 直接复用。
        _availableObjects.Push(instance);

        // 返回归还成功结果。
        return true;
    }

    // ─── 清理 ───────────────────────────────────────────────────

    /// <summary>
    /// 清理当前对象池拥有的所有对象和内部容器。
    /// </summary>
    public void Clear()
    {
        // 清理逻辑统一放到私有方法，供外部主动清理和 Unity OnDestroy 复用。
        ClearInternal();
    }

    /// <summary>
    /// 执行对象池内部清理，销毁所有已经创建的对象。
    /// </summary>
    private void ClearInternal()
    {
        // 遍历所有权集合，而不是只遍历可用栈，确保正在使用中的对象也会被清理。
        foreach (GameObject instance in _ownedObjects)
        {
            // Unity 对象可能已经被外部销毁，因此销毁前需要先判断引用是否仍然有效。
            if (instance != null)
            {
                // 清理对象池创建的对象，避免场景切换后残留实例。
                Destroy(instance);
            }
        }

        // 清空可用对象栈，避免继续取出已经销毁的对象引用。
        _availableObjects.Clear();

        // 清空所有权集合，表示当前池不再拥有任何对象。
        _ownedObjects.Clear();

        // 清空租借集合，表示当前池不再有处于使用状态的对象。
        _leasedObjects.Clear();
    }
}
